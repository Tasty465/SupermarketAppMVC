<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container d-flex align-items-center justify-content-center" style="min-height:75vh;">
      <div class="card p-4 text-center" style="max-width:640px; width:100%;">
        <h2 class="mb-3">Welcome to Supermarket App</h2>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <p>Welcome back, <strong><%= user.username %></strong></p>
            <a class="btn btn-primary me-2" href="/inventory">Go to Inventory</a>
            <a class="btn btn-secondary" href="/logout">Logout</a>
          <% } else { %>
            <p>Welcome back, <strong><%= user.username %></strong></p>
            <a class="btn btn-primary me-2" href="/shopping">Start Shopping</a>
            <a class="btn btn-outline-secondary" href="/cart">View Cart <span class="badge bg-danger ms-1"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span></a>
          <% } %>
        <% } else { %>
          <p>Please log in or register to continue.</p>
          <div class="d-flex gap-2 mt-3">
            <a class="btn btn-primary flex-fill" href="/login">Login</a>
            <a class="btn btn-outline-primary flex-fill" href="/register">Register</a>
          </div>
        <% } %>
      </div>
    </div>
</body>
</html>