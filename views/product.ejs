<!-- product.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>Supermarket App</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
        <br>
        <div class="text-center"><h2>Product Details</h2></div>
        <br>
                <% if (product) { %> <!-- Check if product data exists -->
                        <div class="row">
                            <div class="col-md-5">
                                <div style="position:relative">
                                    <img src="../images/<%= product.image %>" class="img-fluid rounded" style="max-height:320px; object-fit:cover;">
                                    <% if (product.quantity === 0) { %>
                                        <span class="badge bg-danger" style="position:absolute; top:12px; left:12px;">Sold Out</span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <h3><%= product.productName %></h3>
                                <p class="text-muted">In stock: <%= product.quantity %></p>
                                <p class="fw-bold">$<%= product.price.toFixed(2) %></p>
                                <% if (user && user.role === 'admin') { %>
                                    <div class="mt-3">
                                        <a href="/updateProduct/<%= product.id %>" class="btn btn-outline-primary">Edit Product</a>
                                    </div>
                                <% } else if (product.quantity > 0) { %>
                                    <form action="/add-to-cart/<%= product.id %>" method="POST" class="d-flex align-items-center">
                                        <input type="number" name="quantity" value="1" min="1" max="<%= product.quantity %>" step="1" class="form-control me-2" style="width:120px;">
                                        <button type="submit" class="btn btn-primary">Buy</button>
                                    </form>
                                <% } else { %>
                                    <div class="mt-3">
                                        <button class="btn btn-secondary" disabled>Sold Out</button>
                                    </div>
                                <% } %>
                            </div>
                        </div>
        <% } else { %>
            <p>No product found.</p>
        <% } %>
        <% if (user.role === "admin") { %>
          <a href ="/inventory">Back</a>
        <% } else { %>
          <a href ="/shopping">Back</a>
        <% } %>
    </div>
    
</body>
</html>
