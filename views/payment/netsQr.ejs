<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scan to Pay with NETS QR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://unpkg.com/event-source-polyfill"></script>
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .qr-container {
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            max-width: 500px;
            text-align: center;
        }
        .qr-container h1 {
            color: #333;
            margin-bottom: 10px;
            font-weight: bold;
        }
        .qr-status {
            color: #666;
            font-size: 16px;
            margin-bottom: 30px;
        }
        .qr-code-wrapper {
            margin: 30px 0;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
        }
        .qr-code-wrapper img {
            max-width: 100%;
            border-radius: 8px;
        }
        .timer {
            font-size: 24px;
            font-weight: bold;
            color: #667eea;
            margin: 20px 0;
        }
        .timer.warning {
            color: #ffc107;
        }
        .timer.danger {
            color: #dc3545;
        }
        .cancel-btn {
            margin-top: 20px;
        }
        .payment-info {
            background: #f0f4ff;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .payment-info p {
            margin: 0;
            color: #333;
        }
        .payment-amount {
            font-size: 28px;
            font-weight: bold;
            color: #28a745;
            margin: 10px 0;
        }
    </style>
</head>
<body>
    <div class="qr-container">
        <h1>💳 NETS QR Payment</h1>
        <div class="qr-status">Scan the QR code to complete your payment</div>

        <div class="payment-info">
            <p>Payment Amount</p>
            <div class="payment-amount">$<%= total %></div>
        </div>

        <div class="qr-code-wrapper">
            <img src="<%= qrCodeUrl %>" alt="QR Code" />
        </div>

        <div class="timer" id="timer">Time remaining: 5:00</div>
    
        <div id="status" style="color: #666; font-size: 14px; margin: 10px 0;">
            Waiting for payment...
        </div>

        <div class="cancel-btn">
            <a href="/cart" class="btn btn-outline-secondary">Cancel Payment</a>
        </div>
    </div>

    <script>
        let s2sNetsTxnStatus;

        if (s2sNetsTxnStatus) {
            s2sNetsTxnStatus.close();
        }

        const txnRetrievalRef = "<%= txnRetrievalRef %>";
        const url = `/sse/payment-status/${txnRetrievalRef}`;
        const headers = {
            "api-key": "<%= apiKey %>",
            "project-id": "<%= projectId %>",
        };

        console.log("NETS QR Payment initialized for transaction:", txnRetrievalRef);

        // Initialize EventSourcePolyfill with headers
        s2sNetsTxnStatus = new EventSourcePolyfill(url, {
            headers: headers,
            heartbeatTimeout: 150000,
        });

        s2sNetsTxnStatus.addEventListener("message", (event) => {
            const data = JSON.parse(event.data);
            console.log("NETS Query Response:", data);

            // Check for payment success
            if (data.success) {
                if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                document.getElementById('status').innerHTML = '<span style="color: #28a745; font-weight: bold;">✓ Payment Successful!</span>';
                setTimeout(() => {
                    window.location.href = `/payment/nets-qr/success?txn_retrieval_ref=${txnRetrievalRef}`;
                }, 1500);
            } else if (data.fail) {
                if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
                document.getElementById('status').innerHTML = '<span style="color: #dc3545; font-weight: bold;">✗ Payment Failed</span>';
                setTimeout(() => {
                    window.location.href = `/payment/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
                }, 2000);
            }
        });

        // Countdown Timer Logic
        const timerElement = document.getElementById("timer");
        const countdownDuration = 300; // 5 minutes in seconds
        let remainingTime = countdownDuration;

        const updateTimer = () => {
            const minutes = Math.floor(remainingTime / 60);
            const seconds = remainingTime % 60;
            const timeStr = `${minutes}:${seconds.toString().padStart(2, "0")}`;
            timerElement.textContent = `Time remaining: ${timeStr}`;

            // Change color based on time remaining
            timerElement.classList.remove('warning', 'danger');
            if (remainingTime < 60) {
                timerElement.classList.add('danger');
            } else if (remainingTime < 120) {
                timerElement.classList.add('warning');
            }

            remainingTime--;

            if (remainingTime < 0) {
                clearInterval(timerInterval);
                timerElement.textContent = "Transaction timed out.";
                timerElement.classList.add('danger');

                if (s2sNetsTxnStatus) {
                    s2sNetsTxnStatus.close();
                }
                document.getElementById('status').innerHTML = '<span style="color: #dc3545; font-weight: bold;">✗ Payment Timeout</span>';
                setTimeout(() => {
                    window.location.href = `/payment/nets-qr/fail?txn_retrieval_ref=${txnRetrievalRef}`;
                }, 2000);
            }
        };

        // Start the timer
        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer(); // Initial call to set the timer immediately

        // Clean up on page close
        window.addEventListener('beforeunload', () => {
            if (s2sNetsTxnStatus) {
                s2sNetsTxnStatus.close();
            }
        });
    </script>
</body>
</html>
