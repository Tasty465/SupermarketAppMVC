<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Your Invoices</title>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>Invoices</h2>
      <% if (user && user.role === 'admin') { %>
        <a href="/inventory" class="btn btn-outline-secondary">Back</a>
      <% } else { %>
        <a href="/shopping" class="btn btn-outline-secondary">Back to Products</a>
      <% } %>
    </div>

    <table class="table table-striped text-dark">
      <thead class="text-dark bg-light">
        <tr>
          <% if (user && user.role === 'admin') { %>
            <th class="text-dark">Invoice ID</th>
          <% } %>
          <th class="text-dark">Invoice</th>
          <% if (user && user.role === 'admin') { %>
            <th class="text-dark">User ID</th>
          <% } %>
          <th class="text-dark">Created On</th>
          <th class="text-dark">Total before tax</th>
          <th class="text-dark">Total tax</th>
          <th class="text-dark">Total after tax</th>
          <th class="text-dark"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!invoices || invoices.length === 0) { %>
          <tr>
            <td colspan="<%= (user && user.role === 'admin') ? 8 : 6 %>" class="text-center">No invoices found.</td>
          </tr>
        <% } else { %>
          <% invoices.forEach(function(inv){ %>
            <tr>
              <% if (user && user.role === 'admin') { %>
                <td><%= inv.id %></td>
              <% } %>
              <td><%= inv.invoice_number %></td>
              <% if (user && user.role === 'admin') { %>
                <td><%= inv.user_id %></td>
              <% } %>
              <td><%= new Date(inv.created_at).toLocaleString() %></td>
              <td>$<%= Number(inv.subtotal).toFixed(2) %></td>
              <td>$<%= Number(inv.tax).toFixed(2) %></td>
              <td>$<%= Number(inv.total).toFixed(2) %></td>
              <td><a href="/invoice/<%= inv.id %>" class="btn btn-sm btn-primary">View</a></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
